{
  "name": "@papyrus-sdk/engine-rust",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": ["papyrus", "pdf", "rust", "wasm", "document", "viewer"],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "wasm"],
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solrachix/Papyrus.git"
  },
  "homepage": "https://solrachix.github.io/Papyrus/",
  "bugs": { "url": "https://github.com/solrachix/Papyrus/issues" },
  "scripts": {
    "build": "tsup index.ts --dts --format cjs,esm --out-dir dist --clean --sourcemap && node copy-wasm.mjs",
    "build:wasm": "node ../../scripts/build-rust-wasm.mjs"
  },
  "peerDependencies": {
    "@papyrus-sdk/core": ">=0.2.18",
    "@papyrus-sdk/types": ">=0.2.11"
  },
  "devDependencies": {
    "@papyrus-sdk/core": "workspace:*",
    "@papyrus-sdk/types": "workspace:*"
  }
}
