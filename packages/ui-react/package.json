{
  "name": "@papyrus-sdk/ui-react",
  "version": "0.1.2",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solrachix/Papyrus.git"
  },
  "homepage": "https://github.com/solrachix/Papyrus",
  "bugs": {
    "url": "https://github.com/solrachix/Papyrus/issues"
  },
  "scripts": {
    "build": "tsup index.ts --dts --format cjs,esm --out-dir dist --clean --sourcemap"
  },
  "dependencies": {
    "@papyrus-sdk/core": "0.1.3",
    "@papyrus-sdk/types": "0.1.3"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "devDependencies": {
    "react": "^18.2.0"
  }
}
