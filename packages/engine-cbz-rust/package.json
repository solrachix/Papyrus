{
  "name": "@papyrus-sdk/engine-cbz-rust",
  "version": "0.1.1",
  "license": "MIT",
  "keywords": [
    "papyrus",
    "comic",
    "cbz",
    "rust",
    "wasm",
    "reader",
    "engine"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasm"
  ],
  "scripts": {
    "build": "tsup index.ts --dts --format cjs,esm --out-dir dist --clean --sourcemap && node copy-wasm.mjs",
    "build:wasm": "node ../../scripts/build-cbz-rust-wasm.mjs",
    "test:dist": "pnpm build && cd ../.. && pnpm exec vitest run packages/engine-cbz-rust/dist-smoke.test.ts"
  },
  "dependencies": {
    "@papyrus-sdk/engine-cbz": "0.1.2",
    "@papyrus-sdk/engine-comic-core": "0.1.0"
  },
  "peerDependencies": {
    "@papyrus-sdk/core": ">=0.2.19",
    "@papyrus-sdk/types": ">=0.2.12"
  },
  "devDependencies": {
    "@papyrus-sdk/core": "workspace:*",
    "@papyrus-sdk/types": "workspace:*"
  }
}
