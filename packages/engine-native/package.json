{
  "name": "@papyrus-sdk/engine-native",
  "version": "0.1.4",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "android/src",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "ios/*.h",
    "ios/*.m",
    "ios/*.podspec",
    "react-native.config.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solrachix/Papyrus.git"
  },
  "homepage": "https://github.com/solrachix/Papyrus",
  "bugs": {
    "url": "https://github.com/solrachix/Papyrus/issues"
  },
  "scripts": {
    "build": "tsup index.ts --dts --format cjs,esm --out-dir dist --clean --sourcemap",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@papyrus-sdk/core": "0.1.3",
    "@papyrus-sdk/types": "0.1.3"
  },
  "peerDependencies": {
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "react-native": "^0.76.0"
  }
}
