{
  "name": "papyrus-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev:web": "pnpm --filter @papyrus-sdk/example-web dev",
    "build:web": "pnpm --filter @papyrus-sdk/example-web build",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "build:changed": "node scripts/publish-changed.js --build-only",
    "test:phase1": "vitest run",
    "bench:zoom": "pnpm --filter @papyrus-sdk/core build && node scripts/benchmarks/zoom-performance.mjs",
    "fixtures:mobile": "node scripts/benchmarks/generate-mobile-pdf-fixtures.mjs --write",
    "fixtures:mobile:check": "node scripts/benchmarks/generate-mobile-pdf-fixtures.mjs --check",
    "test:e2e:mobile": "maestro test .maestro",
    "lint:phase1": "eslint packages/ui-react/components packages/ui-react-native/components packages/core examples/web examples/mobile/App.tsx examples/mobile/__tests__ --ext .ts,.tsx",
    "docs:dev": "pnpm --filter @papyrus-sdk/example-web build -- --mode docs && vitepress dev docs",
    "docs:build": "pnpm --filter @papyrus-sdk/example-web build -- --mode docs && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "bump:packages": "node scripts/bump-packages.js",
    "publish:pre": "node scripts/publish-changed.js --build-only --bump patch",
    "publish:changed": "pnpm publish:pre && pnpm publish:changed:only",
    "publish:changed:only": "node scripts/publish-changed.js"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    }
  },
  "dependencies": {
    "@types/react": "^18.2.6",
    "@vercel/analytics": "^1.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "tsup": "^8.3.5",
    "typescript": "^5.0.4",
    "vitepress": "^1.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.9"
}
