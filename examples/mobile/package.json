{
  "name": "PapyrusMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "preandroid": "pnpm --filter @papyrus-sdk/types build && pnpm --filter @papyrus-sdk/core build && pnpm --filter @papyrus-sdk/engine-native build && pnpm --filter @papyrus-sdk/ui-react-native build",
    "android": "react-native run-android",
    "preios": "pnpm --filter @papyrus-sdk/types build && pnpm --filter @papyrus-sdk/core build && pnpm --filter @papyrus-sdk/engine-native build && pnpm --filter @papyrus-sdk/ui-react-native build",
    "ios": "react-native run-ios",
    "prestart": "pnpm --filter @papyrus-sdk/types build && pnpm --filter @papyrus-sdk/core build && pnpm --filter @papyrus-sdk/engine-native build && pnpm --filter @papyrus-sdk/ui-react-native build",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@papyrus-sdk/core": "workspace:*",
    "@papyrus-sdk/engine-native": "workspace:*",
    "@papyrus-sdk/types": "workspace:*",
    "@papyrus-sdk/ui-react-native": "workspace:*",
    "@react-native-documents/picker": "^12.0.1",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-svg": "^15.5.0",
    "react-native-webview": "^13.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/gradle-plugin": "0.81.0",
    "@react-native/metro-config": "0.81.0",
    "@react-native/typescript-config": "0.81.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
